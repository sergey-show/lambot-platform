---
# Base host prep: docker.io + Compose v2 (binary in cli-plugins), docker service, docker group.
# Called by adapter before provision-gitlab / provision-nexus on the same target.
- name: Prepare Docker host (swarm template)
  hosts: target
  become: true
  vars:
    ssh_user: "{{ ssh_user }}"
  tasks:
    - name: Install Docker engine (Debian family)
      ansible.builtin.apt:
        name: docker.io
        state: present
        update_cache: true
      when: ansible_os_family == "Debian"

    - name: Install Docker engine (generic)
      ansible.builtin.package:
        name: docker.io
        state: present
      when: ansible_os_family != "Debian"

    - name: Ensure Docker CLI plugins directory
      ansible.builtin.file:
        path: /usr/local/lib/docker/cli-plugins
        state: directory
        mode: "0755"

    # Compose download: only Ansible should expand {{ ansible_architecture }} etc.
    # Otherwise the orchestrator Jinja (prepare-bundle) wipes them — URL becomes .../download//docker-compose-linux-
    - name: Install Docker Compose v2 CLI plugin (GitHub release)
      ansible.builtin.get_url:
        url: {% raw %}"https://github.com/docker/compose/releases/download/v2.31.0/docker-compose-linux-{{ {'x86_64': 'x86_64', 'aarch64': 'aarch64', 'armv7l': 'armv7'}[ansible_architecture] | default('x86_64') }}"{% endraw %}
        dest: /usr/local/lib/docker/cli-plugins/docker-compose
        mode: "0755"
        force: false

    - name: Ensure docker service
      ansible.builtin.service:
        name: docker
        state: started
        enabled: true

    - name: Add user to docker group
      ansible.builtin.user:
        name: "{{ ssh_user }}"
        groups: docker
        append: true
