{% raw %}
---
# Three nodes: group masters (one host k8s-master), workers (k8s-worker1, k8s-worker2).
# pod_network_cidr — in inventory all.vars (default 10.244.0.0/16).
- name: OS check
  hosts: all
  become: true
  gather_facts: true
  tasks:
    - name: Debian/Ubuntu only
      ansible.builtin.fail:
        msg: "Only Debian/Ubuntu (apt) is supported. See Kubernetes documentation."
      when: ansible_os_family != "Debian"

- name: Base node prep
  hosts: all
  become: true
  tasks:
    - name: Packages for apt and networking
      ansible.builtin.apt:
        name:
          - apt-transport-https
          - ca-certificates
          - curl
          - gnupg
        state: present
        update_cache: true

    - name: Disable swap
      ansible.builtin.command: swapoff -a
      changed_when: false

    - name: Remove swap from fstab
      ansible.builtin.replace:
        path: /etc/fstab
        regexp: '^([^#].*\sswap\s+sw\s+.*)$'
        replace: '# \1'

    - name: Kernel modules (file)
      ansible.builtin.copy:
        dest: /etc/modules-load.d/k8s.conf
        content: |
          br_netfilter
          overlay
        mode: "0644"

    - name: Upload br_netfilter
      ansible.builtin.command: modprobe br_netfilter
      changed_when: false
      failed_when: false

    - name: Upload overlay
      ansible.builtin.command: modprobe overlay
      changed_when: false
      failed_when: false

    - name: Sysctl for Kubernetes
      ansible.builtin.copy:
        dest: /etc/sysctl.d/99-kubernetes-cri.conf
        content: |
          net.bridge.bridge-nf-call-iptables = 1
          net.bridge.bridge-nf-call-ip6tables = 1
          net.ipv4.ip_forward = 1
        mode: "0644"

    - name: Apply sysctl
      ansible.builtin.command: sysctl --system
      changed_when: false

    - name: Install containerd
      ansible.builtin.apt:
        name: containerd
        state: present

    - name: Default containerd config
      ansible.builtin.shell: containerd config default | tee /etc/containerd/config.toml
      args:
        executable: /bin/bash

    - name: Systemd cgroup for containerd
      ansible.builtin.replace:
        path: /etc/containerd/config.toml
        regexp: "SystemdCgroup = false"
        replace: "SystemdCgroup = true"

    - name: Restart containerd
      ansible.builtin.systemd:
        name: containerd
        state: restarted
        enabled: true

    - name: Directory for Kubernetes apt key
      ansible.builtin.file:
        path: /etc/apt/keyrings
        state: directory
        mode: "0755"

    - name: Kubernetes repository key
      ansible.builtin.get_url:
        url: https://pkgs.k8s.io/core:/stable:/v1.29/deb/Release.key
        dest: /tmp/kubernetes-apt-key.gpg
        mode: "0644"

    - name: Dearmor Kubernetes key
      ansible.builtin.command: gpg --dearmor -o /etc/apt/keyrings/kubernetes-apt-keyring.gpg /tmp/kubernetes-apt-key.gpg
      args:
        creates: /etc/apt/keyrings/kubernetes-apt-keyring.gpg

    - name: Kubernetes repository
      ansible.builtin.apt_repository:
        repo: "deb [signed-by=/etc/apt/keyrings/kubernetes-apt-keyring.gpg] https://pkgs.k8s.io/core:/stable:/v1.29/deb/ /"
        filename: kubernetes
        state: present

    - name: Install kubelet kubeadm kubectl
      ansible.builtin.apt:
        name:
          - kubelet
          - kubeadm
          - kubectl
        state: present
        update_cache: true

    - name: Hold package versions
      ansible.builtin.command: apt-mark hold kubelet kubeadm kubectl
      changed_when: false

    - name: Enable kubelet
      ansible.builtin.systemd:
        name: kubelet
        enabled: true

- name: Initialize control plane
  hosts: masters
  become: true
  tasks:
    - name: kubeadm init
      ansible.builtin.command: "kubeadm init --pod-network-cidr={{ pod_network_cidr | default('10.244.0.0/16') }}"
      args:
        creates: /etc/kubernetes/admin.conf

- name: Pod network (Flannel)
  hosts: masters
  become: true
  run_once: true
  tasks:
    - name: Install Flannel
      ansible.builtin.command: kubectl apply -f https://github.com/flannel-io/flannel/releases/latest/download/kube-flannel.yml
      environment:
        KUBECONFIG: /etc/kubernetes/admin.conf
      register: flannel_apply
      changed_when: flannel_apply.rc == 0

- name: Join command for workers
  hosts: masters
  become: true
  tasks:
    - name: Create join command
      ansible.builtin.command: kubeadm token create --print-join-command
      register: join_cmd
      changed_when: false

- name: Join workers
  hosts: workers
  become: true
  tasks:
    - name: kubeadm join
      ansible.builtin.command: "{{ hostvars['k8s-master']['join_cmd']['stdout'] }}"
      args:
        creates: /etc/kubernetes/kubelet.conf
{% endraw %}
