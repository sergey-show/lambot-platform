<!-- Allow the default user HTTP access from other containers (not only localhost).
     Base image 24.x restricts default to 127.0.0.1 — adapter-service cannot connect otherwise. -->
<clickhouse>
  <users>
    <default>
      <password></password>
      <networks>
        <ip>::/0</ip>
      </networks>
    </default>
  </users>
</clickhouse>
