# Real chat: set the key here OR in Superadmin → LLM settings (stored in admin DB).
# Without a key, llm-adapter returns [MOCK LLM OUTPUT] and llm_provider=mock.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional for llm-adapter (if not set in Superadmin → LLM): coding/agent and embedding models.
# OPENAI_CODING_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LangGraph ReAct (agent-graph-service): graph step limit; tool-calling chains hit a low limit quickly.
# LANGGRAPH_RECURSION_LIMIT=100
# Langfuse — LLM observability (agent-graph-service, llm-adapter-service). Local stack:
#   docker compose --profile langfuse up -d
# External UI: http://localhost:3100 (LANGFUSE_UI_BIND). Langfuse internal DBs have no published ports.
#
# For docker-compose without .env, defaults are already set: LANGFUSE_TRACING_ENABLED=1, LANGFUSE_HOST / LANGFUSE_BASE_URL / keys in Platform/docker-compose.yml (agent-graph, llm-adapter + LANGFUSE_INIT_* on langfuse-web).
# Headless init: org/project/user admin@lambot.local — see langfuse-web service. In production override secrets and keys via CI/shell env.
# For cloud Langfuse override in the environment, e.g.: LANGFUSE_HOST=https://cloud.langfuse.com LANGFUSE_PUBLIC_KEY=... LANGFUSE_SECRET_KEY=...
# LANGFUSE_NEXTAUTH_URL=http://localhost:3100
#
# Explicit SDK keys (if you do not want to use LANGFUSE_INIT_PROJECT_* from .env):
# LANGFUSE_PUBLIC_KEY=lf_pk_lambot_local_dev
# LANGFUSE_SECRET_KEY=lf_sk_lambot_local_dev
# LANGFUSE_TRACING_ENABLED=1   # 0|false|no|off — disable SDK without removing keys
#
# Langfuse Cloud: keys from the project UI + LANGFUSE_HOST=https://cloud.langfuse.com (or us/jp).
# LANGFUSE_NEXTAUTH_SECRET=   # openssl rand -hex 16
# LANGFUSE_ENCRYPTION_KEY=    # openssl rand -hex 32
# LANGFUSE_POSTGRES_PASSWORD=langfuse
# LANGFUSE_REDIS_PASSWORD=langfuse-redis-dev
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_ROOT_USER=minio
# LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
# LANGFUSE_INIT_ORG_ID=lambot-local
# LANGFUSE_INIT_PROJECT_ID=lambot-platform
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_lambot_local_dev
# LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_lambot_local_dev
# LANGFUSE_INIT_USER_EMAIL=admin@lambot.local
# LANGFUSE_INIT_USER_NAME=Lambot Admin
# LANGFUSE_INIT_USER_PASSWORD=lambot-langfuse-admin
# LANGFUSE_UI_BIND=3100
# Legacy broad “execution change” heuristic (words like backend/api/chart → require ssh/k8s on plan steps). 1 = restore old behavior.
# AGENT_ORCHESTRATION_LEGACY_BROAD_EXEC_HEURISTIC=0
# Live execution mode (tools on plan steps): pm/architect steps set live_execution=true in the JSON reply; there is no separate LLM call after intake.
# Direct mode to a single specialist (devops/backend/frontend): without pm — coarse heuristic on the request text (see AGENT_ORCHESTRATION_LEGACY_BROAD_EXEC_HEURISTIC).
# AI bootstrap: on project create, automatically call planning (1 = yes).
# AGENT_BOOTSTRAP_AUTO_PLANNING=1
# AGENT_BOOTSTRAP_INTERNAL_TOKEN=internal-agent-bootstrap-dev-token
# Python sandbox (must match api-gateway / sandbox-service).
# SANDBOX_SERVICE_TOKEN=internal-sandbox-dev-token
# Browser tool (Playwright) for agents:
# BROWSER_ALLOWED_HOSTS=frontend,api-gateway,localhost,127.0.0.1
# BROWSER_ALLOW_PUBLIC_WEB=0
# BROWSER_IDLE_TTL_SEC=900
# Build flag for browser-tool-service: 1 = playwright install --with-deps chromium (needs apt during build), 0 = playwright install chromium.
# PLAYWRIGHT_INSTALL_DEPS=0
# Build flag for adapter-service: 1 = pull ansible-galaxy roles/collections during docker build.
# On unstable networks leave 0 so other services are not blocked by the build.
# INSTALL_ANSIBLE_GALAXY=0
# Optional system deps for the backend image (openssh/git/curl/kubectl). Leave 0 under network restrictions.
# INSTALL_SYSTEM_DEPS=0
# GitLab platform (one instance for the whole site): on project.created a group + group access token is created.
# Local compose: docker compose --profile gitlab up -d  → http://localhost:8929
# GITLAB_CE_BIND=8929
# GITLAB_CE_EXTERNAL_URL=http://gitlab-ce
# GITLAB_URL=http://gitlab-ce
# GITLAB_ADMIN_TOKEN=glpat-...   # root PAT, scope api — after first login to GitLab UI
# GITLAB_ROOT_GROUP_PATH=lambot   # create this group once in the UI
# GITLAB_PROVISION_MOCK=0
# GITLAB_SSL_VERIFY=1
# gitlab-service:8016  repo-workspace-service:8018  code-index-service:8017
# Qdrant (code-index vectors): QDRANT_URL=http://qdrant:6333  QDRANT_BIND=6333
# CODE_INDEX_VECTOR_SIZE=1536   # OpenAI text-embedding-3-small
# KNOWLEDGE_VECTOR_SIZE=768     # Ollama nomic-embed-text etc.; must match model dim
# QDRANT_CODE_COLLECTION=lambot_code_chunks

# Knowledge bases (PDF/images → S3 + Kafka + Qdrant):
# KNOWLEDGE_SERVICE_URL=http://knowledge-service:8019
# KNOWLEDGE_S3_BUCKET=platform-knowledge
# KNOWLEDGE_S3_ENDPOINT_URL=http://rustfs:9000
# KNOWLEDGE_MAX_UPLOAD_BYTES=5242880
# QDRANT_KNOWLEDGE_COLLECTION=lambot_knowledge_chunks
# KAFKA_TOPIC_KNOWLEDGE_INGEST=platform.knowledge.ingest

# Documents service (wiki + RAG):
# DOCUMENTS_SERVICE_URL=http://documents-service:8015
# DOCUMENTS_DATABASE_URL=postgresql+psycopg://platform:platform@postgres-documents:5432/documents_db
# Adapter: SSH without two-step user confirmation for “dangerous” commands (site policy; off by default).
# SSH_SKIP_USER_CONFIRMATION=0
# Seeds for the first write into admin DB (see admin-service DEFAULT_OPENAI_* in docker-compose if needed).
# DEFAULT_OPENAI_CODING_MODEL=
# DEFAULT_OPENAI_EMBEDDING_MODEL=
SUPERADMIN_TOKEN=superadmin-dev-token
USER_BEARER_TOKEN=user-dev-token
JWT_SECRET=dev-jwt-secret
JWT_ALGORITHM=HS256
# Must match on api-gateway and project-service (admin PATCH/DELETE projects).
# INTERNAL_PROJECT_ADMIN_TOKEN=internal-project-admin-dev-token

# Local overrides (defaults match docker-compose service hostnames)
# PROJECT_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/project_db
# PLANNING_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5433/planning_db
# ADMIN_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5434/admin_db
# ORCHESTRATOR_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5435/orchestrator_db
# ADAPTER_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5436/adapter_db
# ADAPTER_FERNET_KEY=  # Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Public ingest for remote agents: Superadmin → Remote agent takes priority; otherwise this variable (adapter fallback).
# AGENT_INGEST_PUBLIC_URL=http://localhost:8000/api/v1/agent/ingest
# ansible-playbook timeout for POST .../infra/run-stack (seconds); first GitLab bring-up can be long.
# ADAPTER_ANSIBLE_TIMEOUT_SEC=7200
# AI-team orchestration: overall run limit and wait for worker execution tasks.
# AGENT_ORCHESTRATION_MAX_SECONDS=10800
# AGENT_ORCHESTRATION_EXECUTION_WAIT_SECONDS=7200
# Intake routing is always LLM-based (no keyword heuristics).
# AGENT_ORCHESTRATION_INTAKE_TIMEOUT_SEC=90
# AGENT_ORCHESTRATION_INTAKE_MAX_TOKENS=256
# Optional lighter model for intake only (empty = default LLM):
# AGENT_ORCHESTRATION_INTAKE_MODEL=
# Inline wiki RAG on every prompt step (heavy, risk of stale status). 0 = agents call get_project_docs_context themselves.
# AGENT_ORCHESTRATION_INLINE_RAG=0
# llm-adapter: for max_tokens <= 256 the upstream does not wait 900s (see LLM_ADAPTER_SHORT_*).
# LLM_ADAPTER_SHORT_UPSTREAM_TIMEOUT_SEC=90
# Activity log (ClickHouse): adapter writes events; UI — GET .../activity-logs
# In compose see docker/clickhouse-users.d/ — image 24.x by default allows default user only from localhost.
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_DATABASE=platform
# Ansible swarm: templates in RustFS. After git pull with new playbooks, once:
# ANSIBLE_S3_SYNC_LOCAL=1
# then docker compose up -d ansible-orchestrator-service and set back to 0 (otherwise every restart overwrites Superadmin edits).
