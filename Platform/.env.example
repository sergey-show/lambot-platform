# Реальный чат: задайте ключ здесь ИЛИ в Superadmin → LLM settings (сохранится в admin DB).
# Без ключа llm-adapter вернёт [MOCK LLM OUTPUT] и llm_provider=mock.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Опционально для llm-adapter (если не задано в Superadmin → LLM): модель кода/агентов и эмбеддингов.
# OPENAI_CODING_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# LangGraph ReAct (agent-graph-service): лимит шагов графа; цепочка tool-calling быстро упирается в низкий лимит.
# LANGGRAPH_RECURSION_LIMIT=100
# Langfuse — observability LLM (agent-graph-service, llm-adapter-service). Локальный стек:
#   docker compose --profile langfuse up -d
# UI наружу: http://localhost:3100 (LANGFUSE_UI_BIND). Внутренние БД Langfuse без проброса портов.
#
# Для docker-compose без .env уже заданы дефолты LANGFUSE_TRACING_ENABLED=1, LANGFUSE_HOST / LANGFUSE_BASE_URL / ключи в Platform/docker-compose.yml (agent-graph, llm-adapter + LANGFUSE_INIT_* у langfuse-web).
# Headless init: org/project/пользователь admin@lambot.local — см. сервис langfuse-web. В проде переопределите секреты и ключи через окружение CI/shell.
# При облачном Langfuse переопределите в окружении, например: LANGFUSE_HOST=https://cloud.langfuse.com LANGFUSE_PUBLIC_KEY=... LANGFUSE_SECRET_KEY=...
# LANGFUSE_NEXTAUTH_URL=http://localhost:3100
#
# Явные ключи SDK (если не хотите использовать LANGFUSE_INIT_PROJECT_* из .env):
# LANGFUSE_PUBLIC_KEY=lf_pk_lambot_local_dev
# LANGFUSE_SECRET_KEY=lf_sk_lambot_local_dev
# LANGFUSE_TRACING_ENABLED=1   # 0|false|no|off — выключить SDK без удаления ключей
#
# Облако Langfuse: ключи из UI проекта + LANGFUSE_HOST=https://cloud.langfuse.com (или us/jp).
# LANGFUSE_NEXTAUTH_SECRET=   # openssl rand -hex 16
# LANGFUSE_ENCRYPTION_KEY=    # openssl rand -hex 32
# LANGFUSE_POSTGRES_PASSWORD=langfuse
# LANGFUSE_REDIS_PASSWORD=langfuse-redis-dev
# LANGFUSE_CLICKHOUSE_USER=clickhouse
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_MINIO_ROOT_USER=minio
# LANGFUSE_MINIO_ROOT_PASSWORD=miniosecret
# LANGFUSE_INIT_ORG_ID=lambot-local
# LANGFUSE_INIT_PROJECT_ID=lambot-platform
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY=lf_pk_lambot_local_dev
# LANGFUSE_INIT_PROJECT_SECRET_KEY=lf_sk_lambot_local_dev
# LANGFUSE_INIT_USER_EMAIL=admin@lambot.local
# LANGFUSE_INIT_USER_NAME=Lambot Admin
# LANGFUSE_INIT_USER_PASSWORD=lambot-langfuse-admin
# LANGFUSE_UI_BIND=3100
# Старая широкая эвристика «execution change» (слова backend/api/график → режим обязательных ssh/k8s на шагах плана). 1 = вернуть как было.
# AGENT_ORCHESTRATION_LEGACY_BROAD_EXEC_HEURISTIC=0
# Режим «живого» исполнения (инструменты на планах): шаги pm/architect в JSON ответа задают live_execution=true; отдельного LLM после intake нет.
# Режим direct к одному специалисту (devops/backend/frontend): без pm — грубая эвристика по тексту запроса (см. AGENT_ORCHESTRATION_LEGACY_BROAD_EXEC_HEURISTIC).
# ИИ-bootstrap: при создании проекта автоматически вызывать planning (1 = да).
# AGENT_BOOTSTRAP_AUTO_PLANNING=1
# AGENT_BOOTSTRAP_INTERNAL_TOKEN=internal-agent-bootstrap-dev-token
# Песочница Python (совпадает с api-gateway / sandbox-service).
# SANDBOX_SERVICE_TOKEN=internal-sandbox-dev-token
# Browser tool (Playwright) для агентов:
# BROWSER_ALLOWED_HOSTS=frontend,api-gateway,localhost,127.0.0.1
# BROWSER_ALLOW_PUBLIC_WEB=0
# BROWSER_IDLE_TTL_SEC=900
# Build flag для browser-tool-service: 1 = playwright install --with-deps chromium (требует apt в build), 0 = playwright install chromium.
# PLAYWRIGHT_INSTALL_DEPS=0
# Build flag для adapter-service: 1 = тянуть роли/коллекции ansible-galaxy во время docker build.
# При нестабильной сети оставьте 0, чтобы не блокировать сборку остальных сервисов.
# INSTALL_ANSIBLE_GALAXY=0
# Опциональные системные зависимости backend-образа (openssh/git/curl/kubectl). При сетевых ограничениях оставьте 0.
# INSTALL_SYSTEM_DEPS=0
# GitLab платформа (один инстанс на всю площадку): при project.created создаётся группа + group access token.
# Локально в compose: docker compose --profile gitlab up -d  → http://localhost:8929
# GITLAB_CE_BIND=8929
# GITLAB_CE_EXTERNAL_URL=http://gitlab-ce
# GITLAB_URL=http://gitlab-ce
# GITLAB_ADMIN_TOKEN=glpat-...   # root PAT, scope api — после первого входа в GitLab UI
# GITLAB_ROOT_GROUP_PATH=lambot   # создайте эту группу в UI один раз
# GITLAB_PROVISION_MOCK=0
# GITLAB_SSL_VERIFY=1
# gitlab-service:8016  repo-workspace-service:8018  code-index-service:8017
# Qdrant (векторы code-index): QDRANT_URL=http://qdrant:6333  QDRANT_BIND=6333
# CODE_INDEX_VECTOR_SIZE=1536  # text-embedding-3-small; подстройте под модель эмбеддингов
# QDRANT_CODE_COLLECTION=lambot_code_chunks

# Documents service (wiki + RAG):
# DOCUMENTS_SERVICE_URL=http://documents-service:8015
# DOCUMENTS_DATABASE_URL=postgresql+psycopg://platform:platform@postgres-documents:5432/documents_db
# Adapter: SSH без двухшагового подтверждения пользователем для «опасных» команд (политика площадки; по умолчанию выкл.).
# SSH_SKIP_USER_CONFIRMATION=0
# Сиды для первой записи в admin DB (см. admin-service DEFAULT_OPENAI_* в docker-compose при необходимости).
# DEFAULT_OPENAI_CODING_MODEL=
# DEFAULT_OPENAI_EMBEDDING_MODEL=
SUPERADMIN_TOKEN=superadmin-dev-token
USER_BEARER_TOKEN=user-dev-token
JWT_SECRET=dev-jwt-secret
JWT_ALGORITHM=HS256
# Должен совпадать у api-gateway и project-service (админ PATCH/DELETE проектов).
# INTERNAL_PROJECT_ADMIN_TOKEN=internal-project-admin-dev-token

# Local overrides (defaults match docker-compose service hostnames)
# PROJECT_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5432/project_db
# PLANNING_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5433/planning_db
# ADMIN_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5434/admin_db
# ORCHESTRATOR_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5435/orchestrator_db
# ADAPTER_DATABASE_URL=postgresql+psycopg://platform:platform@localhost:5436/adapter_db
# ADAPTER_FERNET_KEY=  # Fernet key from: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Публичный ingest для remote-агентов: приоритет у Superadmin → Remote agent; иначе эта переменная (adapter fallback).
# AGENT_INGEST_PUBLIC_URL=http://localhost:8000/api/v1/agent/ingest
# Таймаут ansible-playbook для POST .../infra/run-stack (секунды); первый старт GitLab может быть долгим.
# ADAPTER_ANSIBLE_TIMEOUT_SEC=7200
# Оркестрация AI-team: общий лимит прогона и ожидание execution-задач воркеров.
# AGENT_ORCHESTRATION_MAX_SECONDS=10800
# AGENT_ORCHESTRATION_EXECUTION_WAIT_SECONDS=7200
# Быстрая маршрутизация (intake): эвристика по ключевым словам (без LLM), таймаут и лёгкая модель.
# AGENT_ORCHESTRATION_INTAKE_HEURISTIC=1
# AGENT_ORCHESTRATION_INTAKE_TIMEOUT_SEC=90
# AGENT_ORCHESTRATION_INTAKE_MAX_TOKENS=120
# AGENT_ORCHESTRATION_INTAKE_MODEL=qwen2.5:3b
# RAG wiki в каждый шаг промпта (тяжело, риск устаревших статусов). 0 = агенты сами: get_project_docs_context.
# AGENT_ORCHESTRATION_INLINE_RAG=0
# llm-adapter: для max_tokens <= 256 upstream не ждёт 900s (см. LLM_ADAPTER_SHORT_*).
# LLM_ADAPTER_SHORT_UPSTREAM_TIMEOUT_SEC=90
# Журнал действий (ClickHouse): adapter пишет события; UI — GET .../activity-logs
# В compose см. docker/clickhouse-users.d/ — образ 24.x по умолчанию пускает default только с localhost.
# CLICKHOUSE_HOST=clickhouse
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_DATABASE=platform
# Ansible swarm: шаблоны в RustFS. После git pull с новыми плейбуками один раз:
# ANSIBLE_S3_SYNC_LOCAL=1
# затем docker compose up -d ansible-orchestrator-service и вернуть 0 (иначе каждый рестарт затирает правки из Superadmin).
